<Window
    x:Class="VoicePilot.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:VoicePilot.App.Controls"
    xmlns:viewmodels="using:VoicePilot.App.ViewModels"
    Title="VoicePilot"
    x:DataType="viewmodels:MainViewModel">
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.RowSpan="2" Padding="28,24,20,24" VerticalScrollBarVisibility="Auto">
            <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="12">
                <FontIcon Glyph="&#xE767;" FontSize="24" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <TextBlock Text="VoicePilot" Style="{ThemeResource TitleTextBlockStyle}" />
            </StackPanel>
            <TextBlock Grid.Row="1" Margin="0,10,0,26" Text="桌面实时语音翻译"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

            <StackPanel Grid.Row="2" Spacing="16">
                <TextBlock Text="音源" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                <ComboBox x:Name="SourceModeComboBox" HorizontalAlignment="Stretch"
                          IsEnabled="{x:Bind ViewModel.IsStopped, Mode=OneWay}"
                          ItemsSource="{x:Bind ViewModel.SourceModes}"
                          SelectedItem="{x:Bind ViewModel.SelectedSourceMode, Mode=TwoWay}"
                          DisplayMemberPath="DisplayName" />
                <ComboBox x:Name="MicrophoneComboBox" Header="麦克风" HorizontalAlignment="Stretch"
                          Visibility="{x:Bind ViewModel.NeedsMicrophone, Mode=OneWay}"
                          IsEnabled="{x:Bind ViewModel.IsStopped, Mode=OneWay}"
                          ItemsSource="{x:Bind ViewModel.Microphones}"
                          SelectedItem="{x:Bind ViewModel.SelectedMicrophone, Mode=TwoWay}"
                          DisplayMemberPath="DisplayName" />
                <TextBlock Text="{x:Bind ViewModel.MicrophoneDeviceId, Mode=OneWay}" TextTrimming="CharacterEllipsis"
                           Visibility="{x:Bind ViewModel.NeedsMicrophone, Mode=OneWay}"
                           Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <ComboBox x:Name="PlaybackComboBox" Header="系统声音播放设备" HorizontalAlignment="Stretch"
                          Visibility="{x:Bind ViewModel.NeedsPlayback, Mode=OneWay}"
                          IsEnabled="{x:Bind ViewModel.IsStopped, Mode=OneWay}"
                          ItemsSource="{x:Bind ViewModel.PlaybackDevices}"
                          SelectedItem="{x:Bind ViewModel.SelectedPlayback, Mode=TwoWay}"
                          DisplayMemberPath="DisplayName" />
                <TextBlock Text="{x:Bind ViewModel.PlaybackDeviceId, Mode=OneWay}" TextTrimming="CharacterEllipsis"
                           Visibility="{x:Bind ViewModel.NeedsPlayback, Mode=OneWay}"
                           Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Expander Header="混合增益" HorizontalAlignment="Stretch"
                          Visibility="{x:Bind ViewModel.NeedsBothDevices, Mode=OneWay}"
                          IsEnabled="{x:Bind ViewModel.IsStopped, Mode=OneWay}">
                    <StackPanel Spacing="12">
                        <Slider Header="麦克风" Minimum="0" Maximum="1" StepFrequency="0.05"
                                Value="{x:Bind ViewModel.MicrophoneGain, Mode=TwoWay}" />
                        <Slider Header="系统声音" Minimum="0" Maximum="1" StepFrequency="0.05"
                                Value="{x:Bind ViewModel.PlaybackGain, Mode=TwoWay}" />
                    </StackPanel>
                </Expander>
                <Button Content="刷新设备" Command="{x:Bind ViewModel.RefreshDevicesCommand}"
                        HorizontalAlignment="Stretch" IsEnabled="{x:Bind ViewModel.IsStopped, Mode=OneWay}" />
                <InfoBar IsOpen="True" Severity="Informational" IsClosable="False" Title="仅在手动启动后采集"
                         Message="不保存原始音频；拔出设备后会停止，不会自动改录其他设备。" />
            </StackPanel>

            <StackPanel Grid.Row="4" Spacing="12">
                <TextBlock Text="识别与翻译" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                <ComboBox Header="原始语言" HorizontalAlignment="Stretch"
                          IsEnabled="{x:Bind ViewModel.IsStopped, Mode=OneWay}"
                          ItemsSource="{x:Bind ViewModel.SourceLanguages}"
                          SelectedItem="{x:Bind ViewModel.SelectedSourceLanguage, Mode=TwoWay}"
                          DisplayMemberPath="DisplayName" />
                <ComboBox Header="目标语言" HorizontalAlignment="Stretch"
                          IsEnabled="{x:Bind ViewModel.IsStopped, Mode=OneWay}"
                          ItemsSource="{x:Bind ViewModel.TargetLanguages}"
                          SelectedItem="{x:Bind ViewModel.SelectedTargetLanguage, Mode=TwoWay}"
                          DisplayMemberPath="DisplayName" />
                <ComboBox Header="联调提供程序" HorizontalAlignment="Stretch"
                          IsEnabled="{x:Bind ViewModel.IsStopped, Mode=OneWay}"
                          ItemsSource="{x:Bind ViewModel.ProviderOptions}"
                          SelectedItem="{x:Bind ViewModel.SelectedProvider, Mode=TwoWay}"
                          DisplayMemberPath="DisplayName" />
                <TextBlock Text="{x:Bind ViewModel.ProviderDescription, Mode=OneWay}" TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Expander Header="术语提示（可选）" HorizontalAlignment="Stretch"
                          IsEnabled="{x:Bind ViewModel.IsStopped, Mode=OneWay}">
                    <TextBox Header="每行一个：原文=译文" TextWrapping="Wrap" AcceptsReturn="True"
                             MinHeight="64" Text="{x:Bind ViewModel.GlossaryText, Mode=TwoWay}" />
                </Expander>
            </StackPanel>
            </Grid>
        </ScrollViewer>

        <Grid Grid.Column="1" Grid.RowSpan="2" Padding="32,26,32,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Ellipse Width="10" Height="10" VerticalAlignment="Center"
                         Fill="{x:Bind ViewModel.StatusBrush, Mode=OneWay}" />
                <TextBlock Text="{x:Bind ViewModel.StatusTitle, Mode=OneWay}"
                           Style="{ThemeResource SubtitleTextBlockStyle}" />
                <TextBlock Text="{x:Bind ViewModel.CaptureDuration, Mode=OneWay}"
                           VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <InfoBar Grid.Row="1" Margin="0,16,0,16"
                     IsOpen="{x:Bind ViewModel.HasNotification, Mode=OneWay}"
                     IsClosable="False"
                     Severity="{x:Bind ViewModel.NotificationSeverity, Mode=OneWay}"
                     Title="{x:Bind ViewModel.NotificationTitle, Mode=OneWay}"
                     Message="{x:Bind ViewModel.NotificationMessage, Mode=OneWay}" />

            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12">
                <Button x:Name="StartButton" Content="开始翻译" Style="{ThemeResource AccentButtonStyle}"
                        Command="{x:Bind ViewModel.StartCommand}" MinWidth="136" MinHeight="40" />
                <Button x:Name="StopButton" Content="停止采集" Command="{x:Bind ViewModel.StopCommand}"
                        MinWidth="136" MinHeight="40" />
                <Button Content="清空文本" Command="{x:Bind ViewModel.ClearTranscriptCommand}" MinHeight="40" />
            </StackPanel>

            <controls:TranscriptList Grid.Row="3" Margin="0,24,0,0"
                                    ItemsSource="{x:Bind ViewModel.TranscriptLines}">
                <controls:TranscriptList.Header>
                    <Grid Margin="0,0,24,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="最终识别原文" Style="{ThemeResource BodyStrongTextBlockStyle}" Margin="20,0,0,0" />
                        <TextBlock Grid.Column="1" Text="对应译文" Style="{ThemeResource BodyStrongTextBlockStyle}" Margin="28,0,0,0" />
                    </Grid>
                </controls:TranscriptList.Header>
                <controls:TranscriptList.ItemTemplate>
                    <DataTemplate x:DataType="viewmodels:TranscriptLine">
                        <Grid Margin="0,8,12,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="20" Margin="0,0,8,0">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="{x:Bind OriginalText}" TextWrapping="Wrap"
                                               IsTextSelectionEnabled="True" Style="{ThemeResource BodyTextBlockStyle}" />
                                    <TextBlock Text="{x:Bind Timestamp}" Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="20" Margin="8,0,0,0">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="{x:Bind Translation}" TextWrapping="Wrap"
                                               IsTextSelectionEnabled="True" Style="{ThemeResource BodyTextBlockStyle}" />
                                    <TextBlock Text="{x:Bind SimulationBadge}" Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </controls:TranscriptList.ItemTemplate>
            </controls:TranscriptList>

            <Grid Grid.Row="4" Margin="0,20,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="临时识别" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.QueueStatus, Mode=OneWay}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Margin="0,8,0,0"
                           Text="{x:Bind ViewModel.InterimTranscript, Mode=OneWay}"
                           TextWrapping="Wrap" IsTextSelectionEnabled="True"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>
        </Grid>
    </Grid>
</Window>
